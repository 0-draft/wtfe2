---
import Base from "../layouts/Base.astro";
import { href, type Lang, ui } from "../lib/i18n.ts";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<Base lang={lang} path="404/" title={t.notFound} notFound>
  <div class="wrap prose">
    <h1>{t.notFound}</h1>
    <p>{t.notFoundLede}</p>
    <p><a href={href(lang)}>{t.home}</a></p>
  </div>
</Base>
