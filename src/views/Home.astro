---
import ComicCard from "../components/ComicCard.astro";
import { inLang } from "../data/schema.ts";
import Base from "../layouts/Base.astro";
import { comics, sites } from "../lib/data.ts";
import { href, type Lang, ui } from "../lib/i18n.ts";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const linked = sites.filter((s) => s.tier === "linked");
---

<Base lang={lang} path="">
  <section class="wrap hero" aria-labelledby="hero-title">
    <div class="hero__panel panel">
      <p class="hero__caption">wtfe2</p>
      <h1 id="hero-title" class="hero__bubble"><span>{t.tagline}</span></h1>
      <p class="hero__lede">{t.description}</p>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="translated">
    <div class="section-head">
      <h2 id="translated">{t.translated}</h2>
      <span class="badge mono">{comics.length}</span>
    </div>
    <p class="prose lede">{t.translatedLede}</p>
    <div class="grid">
      {comics.map((c, i) => <ComicCard comic={c} lang={lang} eager={i < 3} />)}
    </div>
  </section>

  <section class="wrap block" aria-labelledby="sites">
    <div class="section-head">
      <h2 id="sites">{t.sites}</h2>
      <a href={href(lang, "sites/")}>{t.seeSites}</a>
    </div>
    <p class="prose lede">{t.sitesLede}</p>
    <ul class="spines">
      {
        linked.map((s) => (
          <li class="spine">
            <a href={href(lang, `sites/#${s.id}`)}>
              <span class="spine__name">{s.name}</span>
              <span class="spine__by">{inLang(s.creator, lang)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .hero__panel {
    position: relative;
    padding: clamp(3.2rem, 7vw, 4.5rem) clamp(1.25rem, 5vw, 3.5rem) clamp(1.5rem, 4vw, 2.5rem);
    background:
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--ink) 14%, transparent) 1px, transparent 1.6px) 0 0 / 11px
        11px,
      var(--card);
  }
  .hero__caption {
    position: absolute;
    top: -2.5px;
    left: -2.5px;
    margin: 0;
    padding: 0.35rem 0.8rem;
    background: var(--hl);
    color: #17150f;
    border: 2.5px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }
  .hero__bubble {
    position: relative;
    display: inline-block;
    margin: 0 0 clamp(2.2rem, 5vw, 3rem);
    padding: 0.35em 0.8em 0.4em;
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: clamp(2.4rem, 8.5vw, 5.6rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    background: var(--card);
    border: 3px solid var(--rule);
    border-radius: 48% 52% 46% 54% / 60% 55% 45% 40%;
  }
  /* The tail: an ink triangle with a paper triangle inside it, overlapping the
     balloon's border so the outline opens into the tail. */
  .hero__bubble::before,
  .hero__bubble::after {
    content: "";
    position: absolute;
    clip-path: polygon(0 0, 100% 0, 8% 100%);
  }
  .hero__bubble::before {
    top: calc(100% - 6px);
    left: 30%;
    width: 0.62em;
    height: 0.55em;
    background: var(--rule);
  }
  .hero__bubble::after {
    top: calc(100% - 9px);
    left: calc(30% + 4.5px);
    width: calc(0.62em - 13px);
    height: calc(0.55em - 6px);
    background: var(--card);
  }
  .hero__lede {
    max-width: 52ch;
    margin: 0;
    font-size: clamp(1rem, 2vw, 1.15rem);
  }
  .block {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  .lede {
    margin: 0 0 1.5rem;
    color: var(--ink-2);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
  }
  .spines {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
    gap: 0.75rem;
  }
  .spine a {
    display: grid;
    gap: 0.1rem;
    height: 100%;
    padding: 0.7rem 0.9rem;
    border: 2px solid var(--rule);
    border-left-width: 10px;
    background: var(--card);
    text-decoration: none;
  }
  .spine a:hover {
    border-left-color: var(--accent);
  }
  .spine__name {
    font-weight: 700;
  }
  .spine__by {
    font-size: 0.82rem;
    color: var(--ink-2);
  }
</style>
