---
import type { GetStaticPaths } from "astro";
import { explainers } from "../../../lib/data.ts";
import ExplainerPage from "../../../views/ExplainerPage.astro";

export const getStaticPaths = (() =>
  explainers.map((e) => ({ params: { slug: e.slug }, props: { e } }))) satisfies GetStaticPaths;

const { e } = Astro.props;
---

<ExplainerPage lang="ja" e={e} />
