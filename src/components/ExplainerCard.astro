---
import type { Explainer } from "../data/schema.ts";
import { siteFor } from "../lib/data.ts";
import { asset, href, type Lang } from "../lib/i18n.ts";

interface Props {
  e: Explainer;
  lang: Lang;
}
const { e, lang } = Astro.props;
const site = siteFor(e.site);
const title = lang === "ja" ? e.titleJa : e.title;
---

<article class:list={["xcard", "panel", { "xcard--image": e.image }]}>
  <a class="xcard__link" href={href(lang, `explained/${e.slug}/`)}>
    {
      e.image ? (
        <div class="xcard__art">
          <img src={asset(`strips/${e.image.file}`)} width={e.image.width} height={e.image.height} alt="" loading="lazy" decoding="async" />
        </div>
      ) : (
        <div class="xcard__bubble">
          <p>{e.hook[lang]}</p>
        </div>
      )
    }
    <div class="xcard__cap">
      <p class="kicker">{site.name}</p>
      <h3 class="xcard__title">{title}</h3>
    </div>
  </a>
</article>

<style>
  .xcard {
    transition: transform 120ms ease, box-shadow 120ms ease;
  }
  .xcard:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--rule);
  }
  @media (prefers-reduced-motion: reduce) {
    .xcard {
      transition: none;
    }
    .xcard:hover {
      transform: none;
    }
  }
  .xcard__link {
    display: block;
    text-decoration: none;
  }
  .xcard__art {
    position: relative;
    max-height: 340px;
    overflow: hidden;
    border-bottom: 2.5px solid var(--rule);
    background: #fff;
  }
  .xcard__art img {
    display: block;
    width: 100%;
    height: auto;
  }
  .xcard__bubble {
    padding: 1.6rem 1.1rem 1.4rem;
    border-bottom: 2.5px solid var(--rule);
    background:
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--ink) 12%, transparent) 1px, transparent 1.6px) 0 0 / 10px
        10px,
      var(--paper-2);
  }
  .xcard__bubble p {
    position: relative;
    margin: 0;
    padding: 0.8rem 1rem;
    background: var(--card);
    border: 2.5px solid var(--rule);
    border-radius: 1.4rem;
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: 1.15rem;
    line-height: 1.5;
  }
  .xcard__bubble p::before,
  .xcard__bubble p::after {
    content: "";
    position: absolute;
    clip-path: polygon(0 0, 100% 0, 10% 100%);
  }
  .xcard__bubble p::before {
    top: calc(100% - 1px);
    left: 1.6rem;
    width: 1.1rem;
    height: 0.9rem;
    background: var(--rule);
  }
  .xcard__bubble p::after {
    top: calc(100% - 4px);
    left: calc(1.6rem + 3px);
    width: calc(1.1rem - 8px);
    height: calc(0.9rem - 4px);
    background: var(--card);
  }
  .xcard__cap {
    padding: 0.6rem 0.85rem 0.8rem;
  }
  .xcard__cap .kicker {
    margin: 0;
  }
  .xcard__title {
    font-size: 1.05rem;
    margin: 0.1rem 0 0;
  }
  .xcard__link:hover .xcard__title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
</style>
