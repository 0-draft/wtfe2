---
import type { Bilingual } from "../data/schema.ts";
import { type Lang, ui } from "../lib/i18n.ts";

interface Props {
  text: Bilingual;
  lang: Lang;
}
const { text, lang } = Astro.props;
---

<aside class="takeaway" aria-labelledby="takeaway-label">
  <p id="takeaway-label" class="takeaway__label">{ui[lang].takeaway}</p>
  <p class="takeaway__text">{text[lang]}</p>
</aside>

<style>
  .takeaway {
    position: relative;
    max-width: var(--measure);
    margin: 0 0 2.5rem;
    padding: 1.4rem 1.4rem 1.2rem;
    background: var(--hl);
    color: #17150f;
    border: 2.5px solid var(--rule);
    box-shadow: var(--shadow);
  }
  .takeaway__label {
    position: absolute;
    top: -0.85rem;
    left: 1rem;
    margin: 0;
    padding: 0.05rem 0.6rem;
    background: #17150f;
    color: #ffd94a;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .takeaway__text {
    margin: 0;
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: clamp(1.1rem, 2.4vw, 1.3rem);
    line-height: 1.6;
    font-feature-settings: "palt" 1;
  }
</style>
